            {
              "lens": "people",
              "text": "Agree what humans review for: intent, design, risk"
            },
            {
              "lens": "process",
              "text": "Settle style rules once, not in every review"
            },
            {
              "lens": "tech",
              "text": "AI pre-review for style and obvious defects"
            },
            {
              "lens": "tech",
              "text": "Linters and formatters in CI"
            }
          ]
        }
      ]
    },
    {
