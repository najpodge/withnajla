            {
              "lens": "tech",
              "text": "Automated check that escalates risky PRs to a human"
            }
          ]
        },
        {
          "text": "Too few people trusted to review",
          "remediations": [
            {
              "lens": "people",
              "text": "Grow more reviewers"
            },
            {
              "lens": "people",
              "text": "Pair juniors on reviews"
            },
            {
              "lens": "process",
              "text": "Rotate review duty"
            },
            {
              "lens": "tech",
              "text": "Code owners that spread review across more people"
            }
          ]
        },
        {
          "text": "Reviewers spend time on mechanical issues",
