  "stuck_points": [
    {
      "section": "A",
      "code": "A1",
      "name": "Review backs up",
      "symptom": "Review queues grow and approvals turn into “LGTM”",
      "signals": [
        "Time to first review",
        "Review wait time",
        "Review load per person",
        "PRs merged without review",
        "Escaped defects"
      ],
      "root_causes": [
        {
          "text": "More output arriving than reviewers can judge",
          "remediations": [
            {
              "lens": "people",
              "text": "Agree as a team which changes truly need a human reviewer"
            },
            {
              "lens": "process",
              "text": "PR size limits"
            },
            {
              "lens": "process",
              "text": "Risk-tiered review: agents review agent PRs, humans review what gets escalated"
