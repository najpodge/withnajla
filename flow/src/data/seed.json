{
  "content": {
    "title": "Getting back to flow in human–agent teams",
    "tagline": "A library of where flow gets stuck in human–agent teams, why, and what to try.",
    "definitions": {
      "node": "Does the work. Has capacity.",
      "edge": "Carries work between nodes. Has bandwidth.",
      "source": "Where work comes in.",
      "sink": "Where value lands: customers and the business.",
      "output": "The work moving along the edges.",
      "flow": "What reaches the sink."
    },
    "key_line": "Output is the work moving along the edges. Flow is what reaches the sink.",
    "lenses": {
      "people": "Skills, roles, capacity, relationships",
      "process": "How work moves, norms, rituals, decision rights",
      "tech": "Tools, automation, checks, guardrails"
    },
    "worked_example": {
      "title": "Example: review backs up at Ana and Ben (A1)",
      "setup": "A PM sends PRDs to two engineers, Ana and Ben. Each directs three agents. The agents open about 30 PRs a week, and Ana and Ben review all of them. Output is up; customers get about as many working features as before.",
      "shows_up": "At Ana and Ben (a node).",
      "root_cause": "The human ↔ agent edge sends more PRs than two people can review.",
      "fixes": {
        "people": "Add reviewers (rarely realistic now)",
        "process": "Agents review agent PRs; humans review only what gets escalated",
        "tech": "An automated check that escalates risky PRs to a human"
      },
      "watch": "Escaped defects, not PRs reviewed."
    },
    "practices": [
      {
        "section": "E",
        "title": "Every agent ↔ agent edge needs a human who can see it",
        "points": [
          "Who can see this edge?",
          "Who owns it?",
          "What checks it, other than another agent?"
        ],
        "example": "A coding agent opens a PR, an AI reviewer approves it, and CI runs tests the coding agent also wrote."
      },
      {
        "section": "F",
        "title": "Incidents are where people now learn what the network is doing",
        "points": [
          "Define severity clearly (P0, P1, …)",
          "Track incidents and link them to the changes behind them",
          "Keep blameless postmortems"
        ],
        "example": "A clear severity taxonomy makes trends comparable. Escaped defect rate shows, of everything shipped, how much was wrong."
      }
    ],
    "contact": {
      "linkedin": "linkedin.com/in/najlaelmachtoub",
      "email": "nelmachtoub@gmail.com",
      "newsletter": "https://withnajla.substack.com/"
    }
  },
